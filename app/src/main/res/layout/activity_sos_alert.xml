<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Warning Icon -->
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@android:drawable/ic_dialog_alert"
        android:contentDescription="Warning"
        android:layout_marginBottom="16dp"/>

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="UNSAFE SITUATION DETECTED"
        android:textColor="#E53935"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <!-- Risk Level -->
    <TextView
        android:id="@+id/tvRiskLevel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Risk Level: 0%"
        android:textColor="#FF9800"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <!-- Summary -->
    <TextView
        android:id="@+id/tvSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#CCCCCC"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333355"
        android:layout_marginBottom="24dp"/>

    <!-- Countdown -->
    <TextView
        android:id="@+id/tvCountdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Auto SOS in: 03:00"
        android:textColor="#FF9800"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressCountdown"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginBottom="16dp"/>

    <!-- Info -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SOS will be sent automatically to your emergency contacts if you do not respond."
        android:textColor="#888888"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginBottom="40dp"/>

    <!-- Buttons -->
    <Button
        android:id="@+id/btnSendSOSNow"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/sos_button"
        android:text="SEND SOS NOW"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnImSafe"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/btn_outline_purple"
        android:text="I am Safe - Dismiss"
        android:textColor="#9B2FC9"
        android:textSize="15sp"
        android:textStyle="bold"/>

</LinearLayout>