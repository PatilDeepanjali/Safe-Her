<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF7FD">

    <!-- ── 1. CLEAN MINIMAL APP BAR (Matches Screenshot 3) ── -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FBF7FD"
        android:orientation="vertical"
        android:paddingTop="32dp"
        android:paddingBottom="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#1E1A22" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Safe Route"
                android:textColor="#1E1A22"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivMore"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_more"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#494551" />

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/circle_purple">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="#FFFFFF" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ── 2. SCROLLABLE BODY WITH MINIMAL MODERN CARDS ── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="84dp"
        android:layout_marginBottom="60dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="24dp">

            <!-- ── WAYPOINT SEARCH CARD (Clean Pill Style from Image 3) ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_search_card"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Inputs Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Origin Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_input_pill"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp"
                            android:layout_marginBottom="6dp">

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/circle_green_dot"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/tvCurrentLocation"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="MG Road Metro"
                                android:textColor="#1E1A22"
                                android:textSize="13sp"
                                android:singleLine="true" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@android:drawable/ic_menu_close_clear_cancel"
                                app:tint="#7A7583" />
                        </LinearLayout>

                        <!-- Destination Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_input_pill"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@android:drawable/ic_menu_mylocation"
                                app:tint="#432587"
                                android:layout_marginEnd="8dp" />

                            <EditText
                                android:id="@+id/etDestination"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Greenwood Residency"
                                android:hint="Where to? (Type place or tap map)"
                                android:textColor="#1E1A22"
                                android:textColorHint="#9E98A6"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:background="@null"
                                android:imeOptions="actionSearch"
                                android:inputType="textPostalAddress"
                                android:singleLine="true" />

                            <ImageView
                                android:id="@+id/btnSearchDestination"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:padding="6dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@android:drawable/ic_menu_search"
                                app:tint="#432587" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Swap Button -->
                    <FrameLayout
                        android:id="@+id/btnSwapEndpoints"
                        android:layout_width="40dp"
                        android:layout_height="82dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_input_pill">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_sort_by_size"
                            app:tint="#432587" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Quick Location Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/chipHome"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_chip_pill"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="🏠 Home"
                        android:textColor="#1E1A22"
                        android:textSize="11sp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/chipWork"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_chip_pill"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="💼 Work"
                        android:textColor="#1E1A22"
                        android:textSize="11sp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/chipCafe"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_chip_pill"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="☕ Blue Tokai"
                        android:textColor="#1E1A22"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── MAP CONTAINER (Edge-to-Edge with Overlay Badges) ── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="310dp"
                android:background="@drawable/bg_search_card"
                android:layout_marginBottom="12dp">

                <FrameLayout
                    android:id="@+id/mapFragmentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Floating Lamp Density Overlay Badge (Bottom Left) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_input_pill"
                    android:backgroundTint="#FAFFFFFF"
                    android:elevation="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/circle_green_dot"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="96 Safe Corridor Lamps Active"
                        android:textColor="#1E1A22"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Floating Recenter FAB (Bottom Right) -->
                <FrameLayout
                    android:id="@+id/btnRecenter"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/circle_purple"
                    android:elevation="4dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_mylocation"
                        app:tint="#FFFFFF" />
                </FrameLayout>
            </FrameLayout>

            <!-- ── 3. MINIMAL ROUTE CONTROLS (Screenshot 3 Design) ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_search_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="10dp">

                <!-- Priority Slider Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Priority"
                        android:textColor="#1E1A22"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSliderScoreBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_safety_teal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="Safest"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekRoutePriority"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="2"
                    android:progress="0"
                    android:thumbTint="#432587"
                    android:progressTint="#5B3FA0"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Safest"
                        android:textColor="#006A61"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Balanced"
                        android:textColor="#494551"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="Fastest"
                        android:textColor="#BA1A1A"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── ROUTE CARDS (Clean Minimal Design) ── -->
            <!-- Card 1: Safest (Active by default) -->
            <LinearLayout
                android:id="@+id/cardRoute1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_route_active"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRoute1Details"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24 min • 1.8 km"
                        android:textColor="#1E1A22"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRoute1Feature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡 Well-lit corridors"
                        android:textColor="#006A61"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRoute1Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_safety_teal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="9.2 Safety"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card 2: Balanced Route -->
            <LinearLayout
                android:id="@+id/cardRoute2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_route_inactive"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRoute2Details"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18 min • 1.4 km"
                        android:textColor="#1E1A22"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRoute2Feature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏪 Active commercial"
                        android:textColor="#494551"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRoute2Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_safety_sand"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="7.8 Safety"
                    android:textColor="#7E4200"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card 3: Shortest Route -->
            <LinearLayout
                android:id="@+id/cardRoute3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_route_inactive"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRoute3Details"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="13 min • 1.1 km"
                        android:textColor="#1E1A22"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRoute3Feature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️ Dim lighting"
                        android:textColor="#BA1A1A"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRoute3Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_safety_red"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="5.4 Caution"
                    android:textColor="#BA1A1A"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ── DEVIATION ALERT BANNER (Clean Design like Screenshot 4) ── -->
            <LinearLayout
                android:id="@+id/cardDeviationAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_safety_red"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@android:drawable/stat_notify_error"
                        app:tint="#BA1A1A"
                        android:layout_marginEnd="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Off Safe Route"
                            android:textColor="#93000A"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDeviationSubtext"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="120 m off safe route • Unverified corridor"
                            android:textColor="#BA1A1A"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginTop="10dp">

                    <Button
                        android:id="@+id/btnRerouteSafe"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/btn_primary_purple"
                        android:text="Re-route"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnDismissDeviation"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_button"
                        android:text="I'm OK"
                        android:textColor="#494551"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── PRIMARY ACTION BUTTON (Start Journey) ── -->
            <Button
                android:id="@+id/btnSafeRoute"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_primary_purple"
                android:text="▲  Start Journey"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- ── SECONDARY ACTION PILLS ROW ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="6dp">

                <Button
                    android:id="@+id/btnShareLocation"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_pill_button"
                    android:text="🎯 Share"
                    android:textColor="#1E1A22"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnFakeCall"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_pill_button"
                    android:text="📞 Call"
                    android:textColor="#432587"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnTestDeviation"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_button"
                    android:text="⚠️ 120m"
                    android:textColor="#BA1A1A"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Optional Hidden Tracking Button for BaseActivity compatibility -->
            <Button
                android:id="@+id/btnStartStop"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTrackingStatus"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- Subtle Minimal Footer (from Screenshot 3) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Scores based on city lighting and incident reports."
                android:textColor="#7A7583"
                android:textSize="10sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── BOTTOM NAVIGATION ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:weightSum="4">

        <LinearLayout
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_compass"
                android:alpha="0.4" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#999999"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabContacts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_call"
                android:alpha="0.4" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contacts"
                android:textColor="#999999"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabMap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_mylocation"
                app:tint="#432587" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Map"
                android:textColor="#432587"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
